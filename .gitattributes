# Windows batch files must keep CRLF - stored as-is so even a ZIP download
# gets them, or cmd can mis-jump to labels.
*.bat -text

# Shell scripts must keep LF, or /bin/sh reads the carriage return as part of
# the command, and every line fails on a stray carriage return.
*.sh text eol=lf

# Third-party files bundled as published: keep their bytes exactly.
static/vendor/** -text

# Left out of release zips
.github export-ignore
.gitattributes export-ignore
# The Steam Workshop item: 7 MB of gallery art and a mod that is
# uploaded from here, none of which a player downloading KnoxMap needs.
workshop export-ignore
branding/window.png export-ignore
# The Rust compiler's test maps (about 50 MB, in the worlded-rusted repository) are not in
# this repository; if they are put here, keep them out of release zips.
rust/knoxlots/fixtures export-ignore
rust/knoxlots/experiments export-ignore
# The tests are for this repository, not for players: 107 of the files in a
# download, and the installed app runs none of them. CI checks out the
# repository rather than the zip and is unaffected.
tests export-ignore
# The tooling for whoever works on KnoxMap - a linter and its settings. A
# player's download has no use for either, and keeping them out of the zip is
# also what keeps tools/check_manifest.py's comparison exact.
pyproject.toml export-ignore
requirements-dev.txt export-ignore
# The frontend checks' own tooling: ESLint, its settings and the lockfile the
# CI job installs from. A player's download runs no JavaScript build.
package.json export-ignore
package-lock.json export-ignore
eslint.config.js export-ignore

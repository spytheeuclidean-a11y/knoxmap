# The Windows launcher, built by .github/workflows/launcher.yml and put in
# the Windows download. A binary does not belong in the repository.
/KnoxMap.exe

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Generated maps, OpenStreetMap downloads and compiled lots. Large, and built
# from OSM data rather than source. The folder itself is kept.
output/*
!output/.gitkeep

# Setup installs the map tools here and writes local paths here.
/vendor/
knoxmap_config.json

# Building the patched compiler yourself
worlded/src/
worlded/build/

# Never commit Project Zomboid game artwork. Setup extracts it from each
# player's own install; it is The Indie Stone's and not ours to share.
Tiles/
*.pack

# Logs and leftovers
*.log
*.orig
*.bak

# Kept from the original project
.DS_Store
.claude/
CLAUDE.local.md
knoxmap_error.log

# Map tiles cached by the app, per the OSM tile policy
cache/

# A private Python that Setup.bat downloads when the PC has none
.python/
.python.zip

# Logs and problem reports (knoxlog.py)
logs/

# Downloaded updates (updater.py)
update/
.knoxmap_files.json

# Buildings built by hand (knoxbuild/presets.py, knoxbuild/designer.py).
# Somebody's own buildings, kept beside the app rather than in it.
# presets/library/ is the other half - buildings people sent in, which ship
# with KnoxMap - and that one belongs in the repository.
presets/buildings/

# Areas and buildings written out to send to somebody (knoxbuild/share.py).
preset_exports/
